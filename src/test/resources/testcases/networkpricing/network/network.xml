	    <!-- toll roads: the link segments tolled together, and who pays on them, never what they pay, which the network pricing says -->
	    <tollroads>
	      <tollroad id="m4" name="M4 and M4 East" lsrefs="101,102"/>
	      <tollroad id="rozelle" name="Rozelle Interchange" lsrefs="103"/>
	      <tollroad id="m8" name="M8" lsrefs="104,105"/>
	      <tollroad id="m5east" name="M5 East" lsrefs="106"/>
	      <tollroad id="bridge" name="Sydney Harbour Bridge" lsrefs="2045"/>
	      <tollroad id="tunnel" name="Sydney Harbour Tunnel" lsrefs="2046"/>
	      <tollroad id="truckroad" name="Truck toll road" pricedmoderefs="heavygoods" lsrefs="701,702"/>
	      <tollroad id="orbital" name="Orbital motorway" lsrefs="801,802,803,804"/>
	      <tollroad id="ticketroad" name="Closed motorway, ticket system" lsrefs="601,602,603,611,612,613,621,622,630,631,632,633"/>
	      <tollroad id="cordon" name="City cordon crossings" lsrefs="3001,3002,3003"/>
	      <tollroad id="zone" name="Congestion charge zone" lsrefs="4001,4002,4003,4004"/>
