	      <node id="t2"/>
	      <node id="tb"/>
	      <node id="o0"/>
	      <node id="o1"/>
	      <node id="o2"/>
	      <node id="k1"/>
	      <node id="c1"/>
	      <node id="k2"/>
	      <node id="c2"/>
	      <node id="k3"/>
	      <node id="c3"/>
	      <node id="z0"/>
	      <node id="z1"/>
	      <node id="z2"/>
	      <node id="z3"/>
	      <node id="p0"/>
	      <node id="p1"/>
	      <node id="u0"/>
	      <node id="ua"/>
	      <node id="u1"/>
	      <node id="u2"/>
	      <node id="u3"/>
	      <node id="u4"/>
	      <node id="north"/>
	      <node id="central"/>
	      <node id="south"/>
	      <node id="fn"/>
	      <node id="fn2"/>
	      <node id="fc"/>
	      <node id="fc2"/>
	      <node id="fs"/>
	      <node id="x1"/>
	      <node id="x2"/>
	      <node id="x3"/>
	      <node id="x4"/>
	      <node id="x5"/>
	    </nodes>    
	    <links>
	      <link id="1" nodearef="1" nodebref="2">             
	        <name>Broadway</name>                       
	        <gml:LineString>                  
	          <gml:coordinates cs="," ts=" ">150.512796,-34.900145 150.512527,-34.900319</gml:coordinates>
	        </gml:LineString> 
	        <linksegment id="1" dir="a_b" typeref="1">  
	          <numberoflanes>2</numberoflanes>      
	          <maxspeed>50</maxspeed>                       
	        </linksegment>
	        <linksegment id="2" dir="b_a" typeref="1">
	          <numberoflanes>1</numberoflanes>
	          <maxspeed>50</maxspeed>
	        </linksegment>          
	        <length unit="km">1.33</length>                 
	      </link>
	      <!-- WestConnex: M4 and M4 East, Rozelle, M8, M5 East -->
	      <link id="l9001" nodearef="wa" nodebref="w0">
	        <linksegment id="9001" dir="a_b" typeref="primary"/>
	        <length unit="km">1.0</length>
	      </link>
	      <link id="l101" nodearef="w0" nodebref="w1">
	        <linksegment id="101" dir="a_b" typeref="motorway"/>
	        <length unit="km">3.0</length>
	      </link>
	      <link id="l102" nodearef="w1" nodebref="w2">
	        <linksegment id="102" dir="a_b" typeref="motorway"/>
	        <length unit="km">2.5</length>
	      </link>
	      <link id="l103" nodearef="w2" nodebref="w3">
	        <linksegment id="103" dir="a_b" typeref="motorway"/>
	        <length unit="km">1.0</length>
	      </link>
	      <link id="l104" nodearef="w3" nodebref="w4">
	        <linksegment id="104" dir="a_b" typeref="motorway"/>
	        <length unit="km">4.0</length>
	      </link>
	      <link id="l105" nodearef="w4" nodebref="w5">
	        <linksegment id="105" dir="a_b" typeref="motorway"/>
	        <length unit="km">2.0</length>
	      </link>
	      <link id="l106" nodearef="w5" nodebref="w6">
	        <linksegment id="106" dir="a_b" typeref="motorway"/>
