<?xml version="1.0" encoding="ISO-8859-1"?>
<macroscopicnetwork
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xmlns:gml="http://www.opengis.net/gml"                     
   xmlns="http://goplanit.org/v2" xsi:schemaLocation="http://goplanit.org/v2 ../../xsd/v2/macroscopicnetworkinput.xsd">
  <id>1</id>
  <!-- the layer "road" holds the toll roads, and the link segments, that the network pricing example
       networkpricing.xml prices -->
  <configuration>
    <!-- the available modes are on the top level configuration of the network -->                                   
    <modes>
      <mode id="car" predefined="true">
        <name>car</name>
      </mode>
      <!-- a predefined mode is named by its PLANit name; its features are PLANit's defaults -->
      <mode id="heavygoods" predefined="true">
        <name>hgv</name>
      </mode>
      <mode id="lightgoods" predefined="true">
        <name>goods</name>
      </mode>
      <mode id="motorcycle" predefined="true">
        <name>motor_bike</name>
      </mode>
      <mode id="taxi" predefined="true">
        <name>taxi</name>
      </mode>
      <mode id="bus" predefined="true">
        <name>bus</name>
      </mode>
      <!-- a custom mode gives its own features -->
      <mode id="electric_car" predefined="false">
        <name>electric car</name>
        <maxspeed>130</maxspeed>
        <pcu>1</pcu>
        <physicalfeatures>
          <vehicletype>vehicle</vehicletype>
          <motorisationtype>motorised</motorisationtype>
          <tracktype>road</tracktype>
        </physicalfeatures>
        <usabilityfeatures>
          <usedtotype>private</usedtotype>
        </usabilityfeatures>
      </mode>
      <mode id="train" predefined="true">
        <name>train</name>
      </mode>
    </modes>        
  </configuration>
  <infrastructurelayers srsname="EPSG:4326">
    <!-- a layer supports a subset of modes, each of which can only occur on one layer each  -->
    <layer id="road" externalid="someid" modes="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
      <!-- each layer has its own configuration, in case of a macroscopic network these contain the link segment types -->
      <layerconfiguration>
          <linksegmenttypes>                                
			      <linksegmenttype id="1">                          
			        <name>local road</name>                         
			        <maxdensitylane>180</maxdensitylane>                  
			        <capacitylane>2000</capacitylane>                   
			        <access>
			          <accessgroup moderefs="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
			            <maxspeed>40</maxspeed>                     
			            <critspeed>35</critspeed>                   
			          </accessgroup>
			        </access>
			      </linksegmenttype>
          <linksegmenttype id="motorway">
            <name>motorway</name>
            <maxdensitylane>180</maxdensitylane>
            <capacitylane>2000</capacitylane>
            <access>
              <accessgroup moderefs="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
                <maxspeed>100</maxspeed>
              </accessgroup>
            </access>
          </linksegmenttype>
          <linksegmenttype id="motorway_link">
            <name>motorway link</name>
            <maxdensitylane>180</maxdensitylane>
            <capacitylane>1500</capacitylane>
            <access>
              <accessgroup moderefs="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
                <maxspeed>60</maxspeed>
              </accessgroup>
            </access>
          </linksegmenttype>
          <linksegmenttype id="trunk">
            <name>trunk</name>
            <maxdensitylane>180</maxdensitylane>
            <capacitylane>1800</capacitylane>
            <access>
              <accessgroup moderefs="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
                <maxspeed>80</maxspeed>
              </accessgroup>
            </access>
          </linksegmenttype>
          <linksegmenttype id="primary">
            <name>primary</name>
            <maxdensitylane>180</maxdensitylane>
            <capacitylane>1600</capacitylane>
            <access>
              <accessgroup moderefs="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
                <maxspeed>60</maxspeed>
              </accessgroup>
            </access>
          </linksegmenttype>
          <linksegmenttype id="secondary">
            <name>secondary</name>
            <maxdensitylane>180</maxdensitylane>
            <capacitylane>1200</capacitylane>
            <access>
              <accessgroup moderefs="car,heavygoods,lightgoods,motorcycle,electric_car,taxi,bus">
                <maxspeed>50</maxspeed>
              </accessgroup>
            </access>
          </linksegmenttype>
			    </linksegmenttypes> 
      </layerconfiguration>
      <!-- ids of nodes, links, still need to be unique across layers to make sure outputs can easily be identified, internal ids
           might not be unique across all layers, depending on how it is configured, but should be unique within the context (layer).
           the user however should not be aware of this -->
	    <nodes>
	      <node id="1">                                 
	        <name>George Street roundabout</name>
	        <gml:Point>
	          <gml:pos>150.512796 -34.900145</gml:pos>
	        </gml:Point>                            
	      </node>
	      <node id="2"> 
	        <name>Broadway intersection</name>
	        <gml:Point>
	          <gml:pos>150.512527 -34.900319</gml:pos>
	        </gml:Point>          
	      </node>       
	      <node id="wa"/>
	      <node id="w0"/>
	      <node id="w1"/>
	      <node id="w2"/>
