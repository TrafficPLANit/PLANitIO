	      <link id="l9002" nodearef="w6" nodebref="wb">
	        <linksegment id="9002" dir="a_b" typeref="primary"/>
	        <length unit="km">1.0</length>
	      </link>
	      <!-- Sydney Harbour Bridge and Tunnel, southbound -->
	      <link id="l9101" nodearef="ha" nodebref="hn">
	        <linksegment id="9101" dir="a_b" typeref="trunk"/>
	        <length unit="km">1.0</length>
	      </link>
	      <link id="l2045" nodearef="hn" nodebref="hc">
	        <linksegment id="2045" dir="a_b" typeref="trunk"/>
	        <length unit="km">1.1</length>
	      </link>
	      <link id="l9102" nodearef="hb" nodebref="ht">
	        <linksegment id="9102" dir="a_b" typeref="motorway"/>
	        <length unit="km">1.0</length>
	      </link>
	      <link id="l2046" nodearef="ht" nodebref="hc">
	        <linksegment id="2046" dir="a_b" typeref="motorway"/>
	        <length unit="km">2.3</length>
	      </link>
	      <link id="l9103" nodearef="hc" nodebref="hd">
	        <linksegment id="9103" dir="a_b" typeref="primary"/>
	        <length unit="km">0.5</length>
	      </link>
	      <!-- Truck toll road -->
	      <link id="l9201" nodearef="ta" nodebref="t0">
	        <linksegment id="9201" dir="a_b" typeref="trunk"/>
	        <length unit="km">1.0</length>
	      </link>
	      <link id="l701" nodearef="t0" nodebref="t1">
	        <linksegment id="701" dir="a_b" typeref="trunk"/>
	        <length unit="km">5.0</length>
	      </link>
	      <link id="l702" nodearef="t1" nodebref="t2">
	        <linksegment id="702" dir="a_b" typeref="trunk"/>
	        <length unit="km">5.0</length>
	      </link>
	      <link id="l9202" nodearef="t2" nodebref="tb">
	        <linksegment id="9202" dir="a_b" typeref="trunk"/>
	        <length unit="km">1.0</length>
	      </link>
	      <!-- Orbital motorway, both directions: 801 and 802 westbound, 803 and 804 eastbound -->
	      <link id="l8001" nodearef="o0" nodebref="o1">
	        <linksegment id="803" dir="a_b" typeref="motorway"/>
	        <linksegment id="802" dir="b_a" typeref="motorway"/>
	        <length unit="km">6.0</length>
	      </link>
	      <link id="l8002" nodearef="o1" nodebref="o2">
	        <linksegment id="804" dir="a_b" typeref="motorway"/>
	        <linksegment id="801" dir="b_a" typeref="motorway"/>
	        <length unit="km">6.0</length>
	      </link>
	      <!-- City cordon: the crossings into the city -->
	      <link id="l3001" nodearef="k1" nodebref="c1">
	        <linksegment id="3001" dir="a_b" typeref="primary"/>
	        <length unit="km">0.3</length>
	      </link>
	      <link id="l3002" nodearef="k2" nodebref="c2">
	        <linksegment id="3002" dir="a_b" typeref="primary"/>
	        <length unit="km">0.3</length>
	      </link>
	      <link id="l3003" nodearef="k3" nodebref="c3">
	        <linksegment id="3003" dir="a_b" typeref="primary"/>
	        <length unit="km">0.3</length>
	      </link>
	      <!-- Congestion charge zone: the roads inside it -->
	      <link id="l4001" nodearef="z0" nodebref="z1">
	        <linksegment id="4001" dir="a_b" typeref="primary"/>
	        <length unit="km">0.5</length>
	      </link>
	      <link id="l4002" nodearef="z1" nodebref="z2">
	        <linksegment id="4002" dir="a_b" typeref="primary"/>
	        <length unit="km">0.5</length>
	      </link>
	      <link id="l4003" nodearef="z2" nodebref="z3">
	        <linksegment id="4003" dir="a_b" typeref="primary"/>
	        <length unit="km">0.5</length>
	      </link>
	      <link id="l4004" nodearef="z3" nodebref="z0">
	        <linksegment id="4004" dir="a_b" typeref="primary"/>
	        <length unit="km">0.5</length>
	      </link>
	      <!-- Port roads and an urban motorway, which the truck charge prices or exempts by type and link segment -->
	      <link id="l5001" nodearef="p0" nodebref="p1">
	        <linksegment id="5001" dir="a_b" typeref="secondary"/>
	        <length unit="km">2.0</length>
	      </link>
	      <link id="l5002" nodearef="p1" nodebref="u0">
	        <linksegment id="5002" dir="a_b" typeref="secondary"/>
	        <length unit="km">1.0</length>
	      </link>
	      <link id="l7001" nodearef="ua" nodebref="u0">
	        <linksegment id="7001" dir="a_b" typeref="motorway_link"/>
	        <length unit="km">0.4</length>
	      </link>
	      <link id="l5101" nodearef="u0" nodebref="u1">
	        <linksegment id="5101" dir="a_b" typeref="motorway"/>
	        <length unit="km">1.5</length>
	      </link>
	      <link id="l5102" nodearef="u1" nodebref="u2">
	        <linksegment id="5102" dir="a_b" typeref="motorway"/>
	        <length unit="km">1.5</length>
	      </link>
	      <link id="l5103" nodearef="u2" nodebref="u3">
	        <linksegment id="5103" dir="a_b" typeref="motorway"/>
	        <length unit="km">1.5</length>
	      </link>
	      <link id="l7003" nodearef="u3" nodebref="u4">
	        <linksegment id="7003" dir="a_b" typeref="motorway"/>
	        <length unit="km">1.0</length>
	      </link>
	      <!-- Closed motorway with a ticket system: carriageways between the north, central and south interchanges, their ramps, and the streets the ramps join -->
	      <link id="l630" nodearef="north" nodebref="central">
	        <linksegment id="630" dir="a_b" typeref="motorway"/>
	        <length unit="km">8.0</length>
	      </link>
	      <link id="l631" nodearef="central" nodebref="south">
	        <linksegment id="631" dir="a_b" typeref="motorway"/>
	        <length unit="km">7.0</length>
	      </link>
	      <link id="l632" nodearef="south" nodebref="central">
