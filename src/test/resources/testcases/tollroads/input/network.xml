<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Toll roads paid by the default modes, by heavy goods only, and by all but motorcycles
     0 -0-> 1 -1-> 2 -2-> 3
            ^
            3
            |
            4
-->
<macroscopicnetwork xmlns="http://goplanit.org/v2" xmlns:gml="http://www.opengis.net/gml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://goplanit.org/v2 https://www.goplanit.org/xsd/v2/macroscopicnetworkinput.xsd">
    <id>0</id>
    <configuration>
        <modes>
            <mode id="car" predefined="true">
                <name>car</name>
            </mode>
            <mode id="hgv" predefined="true">
                <name>hgv</name>
            </mode>
            <mode id="motor_bike" predefined="true">
                <name>motor_bike</name>
            </mode>
            <mode id="bus" predefined="true">
                <name>bus</name>
            </mode>
        </modes>
    </configuration>
    <infrastructurelayers srsname="EPSG:404000">
        <layer id="0">
            <layerconfiguration>
                <linksegmenttypes>
                    <linksegmenttype id="motorway">
                        <name>motorway</name>
                        <maxdensitylane>180.0</maxdensitylane>
                        <capacitylane>2000.0</capacitylane>
                        <access>
                            <accessgroup moderefs="car,hgv,motor_bike,bus"/>
                        </access>
                    </linksegmenttype>
                </linksegmenttypes>
            </layerconfiguration>
            <nodes>
                <node id="0">
                    <gml:Point>
                        <gml:pos>0 0</gml:pos>
                    </gml:Point>
                </node>
                <node id="1">
                    <gml:Point>
                        <gml:pos>100 0</gml:pos>
                    </gml:Point>
                </node>
                <node id="2">
                    <gml:Point>
                        <gml:pos>200 0</gml:pos>
                    </gml:Point>
                </node>
                <node id="3">
                    <gml:Point>
                        <gml:pos>300 0</gml:pos>
                    </gml:Point>
                </node>
                <node id="4">
                    <gml:Point>
                        <gml:pos>100 100</gml:pos>
                    </gml:Point>
                </node>
            </nodes>
            <links>
                <link id="0" nodearef="0" nodebref="1">
                    <linksegment id="0" dir="a_b" typeref="motorway"/>
                    <length unit="km">0.1</length>
                </link>
                <link id="1" nodearef="1" nodebref="2">
                    <linksegment id="1" dir="a_b" typeref="motorway"/>
                    <length unit="km">0.1</length>
                </link>
                <link id="2" nodearef="2" nodebref="3">
                    <linksegment id="2" dir="a_b" typeref="motorway"/>
                    <length unit="km">0.1</length>
                </link>
                <link id="3" nodearef="4" nodebref="1">
                    <linksegment id="3" dir="a_b" typeref="motorway"/>
                    <length unit="km">0.1</length>
                </link>
            </links>
            <tollroads>
                <tollroad id="m4" externalid="way 7" name="M4" lsrefs="0,1"/>
                <tollroad id="trucks" lsrefs="2" pricedmoderefs="hgv"/>
                <tollroad id="ramp" lsrefs="3" pricedexemptmoderefs="motor_bike"/>
            </tollroads>
        </layer>
    </infrastructurelayers>
</macroscopicnetwork>
